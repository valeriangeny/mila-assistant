# Gemini auth — pick ONE:
#
# A) AI Studio (recommended for local; ignores gcloud default project)
#    Create a key at https://aistudio.google.com/apikey (usually starts with AIza…)
GOOGLE_API_KEY=
#
# B) Vertex + ADC — only if you intend this GCP project (not your other gcloud work)
#    Leave GOOGLE_API_KEY empty/unset, then:
# GOOGLE_CLOUD_PROJECT=your-vertex-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional model id (AI Studio and Vertex names can differ by region).
# Prefer flash-lite when 4.x / 3.8 hit capacity (503); avoid gemini-4-hydrogen locally.
# gemini-3.5-flash-lite | gemini-3.8-flash | gemini-4-hydrogen
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 4 only: low | medium | high | xhigh (default low; API default is high)
GEMINI_THINKING_LEVEL=low

# Guardrails catalog (comma-separated). Default: all MVP rails.
# Names: injection_sanitize, untrusted_framing, user_safety, egress_injection
# MILA_GUARDRAILS=off  # disable
# MILA_GUARDRAILS=injection_sanitize,egress_injection

# Qdrant + local FastEmbed (Phase 2) — no embed API key
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=mila_docs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional IANA timezone for relative dates in the system prompt (default: host local)
# AGENT_TZ=America/Toronto

# LangSmith (optional tracing/evals)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Mila Agent - local:2024
