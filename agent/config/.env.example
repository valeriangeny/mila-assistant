# Gemini auth — pick ONE:
#
# A) AI Studio (recommended for local; ignores gcloud default project)
#    Create a key at https://aistudio.google.com/apikey (usually starts with AIza…)
GOOGLE_API_KEY=
#
# B) Vertex + ADC — only if you intend this GCP project (not your other gcloud work)
#    Leave GOOGLE_API_KEY empty/unset, then:
# GOOGLE_CLOUD_PROJECT=your-vertex-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional model id (AI Studio and Vertex names can differ by region)
# gemini-4-hydrogen | gemini-3.8-flash (3.7 is deprecated and routes to 3.8)
GEMINI_MODEL=gemini-4-hydrogen

# Qdrant (Phase 2+). Compose default:
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=mila_docs

# Optional IANA timezone for relative dates in the system prompt (default: host local)
# AGENT_TZ=America/Toronto

# LangSmith (optional tracing/evals)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Mila Agent - local:2024
