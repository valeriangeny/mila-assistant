{
  "name": "mila-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Permission-aware knowledge assistant for aliM AI Institute",
  "author": "Valerian Geny",
  "workspaces": [
    "copilot"
  ],
  "scripts": {
    "dev:copilot": "yarn workspace copilot dev",
    "build:copilot": "yarn workspace copilot build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "lint:copilot": "yarn workspace copilot lint",
    "test:e2e": "yarn --cwd e2e test",
    "test:e2e:auth": "yarn --cwd e2e test auth-"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
